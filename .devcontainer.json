{
  "name": "Nimbus Windows",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": { "ghcr.io/devcontainers/features/docker-in-docker:2": {} },
  "forwardPorts": [8006],
  "portsAttributes": { "8006": { "label": "Windows (tela)", "onAutoForward": "silent" } },
  "postStartCommand": "curl -fsSL https://nimbuscloudpc.netlify.app/codespace/start-windows.sh | bash"
}
